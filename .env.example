# Copy this file to apps/web/.env.local; Vite runs from apps/web.
# Do not commit local environment files.

# Network name used for SDK defaults (testnet, public, or standalone).
VITE_NETWORK=testnet
# Soroban RPC endpoint for the selected network.
VITE_RPC_URL=https://soroban-testnet.stellar.org:443
# Network passphrase for constructing and signing transactions.
VITE_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
# Deployed streaming contract ID.
VITE_CONTRACT_ID=CABJ22MJTXMZHACHV25MFD6ECVRQ3NRUJ2HYB2B4LVP3PQ6R2N72RN3K
# Default testnet token contract (native XLM Stellar Asset Contract).
VITE_DEFAULT_TOKEN=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC
